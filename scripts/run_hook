#!/bin/sh
# Cross-platform hook launcher (macOS / Linux).
#
# Resolves a Python 3 interpreter and runs a hook script from scripts/.
# Used by hooks/hooks.json so hooks do not hard-code `python3` (absent on many
# Windows installs). Usage:  run_hook <script.py> [args...]
#
# The hook scripts use only the standard library, so no virtualenv is needed.
# They share modules with the MCP server and require Python 3.10+.

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
script="$1"
shift

# Resolve a Python 3 interpreter that actually works. `command -v` alone is
# not enough on Windows: the Microsoft Store ships `python3.exe` /
# `python.exe` stubs in WindowsApps that are on PATH and "exist" but, when
# run, print "Python was not found" and exit non-zero — they would otherwise
# be picked first and silently break every hook. Probe each candidate with
# `-c` so the stubs (and any non-functional alias) are skipped.
# `py` is handled separately because selecting Python 3 requires its `-3` flag.
if command -v py >/dev/null 2>&1; then
    if py -3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec py -3 "$DIR/$script" "$@"
    fi
fi

for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
        if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
            exec "$candidate" "$DIR/$script" "$@"
        fi
    fi
done

echo "improve hook: Python 3.10+ interpreter not found (tried py -3, python3, python)." >&2
exit 1
